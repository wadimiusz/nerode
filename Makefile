# Makefile для nerode (копия Makefile из nanogpt без git-хуков).
#
# Все команды идут через `uv run`: активировать .venv вручную не нужно,
# uv сам найдёт окружение и при необходимости досинхронизирует его.
#
# Быстрый старт:
#   make          показать список целей
#   make check    прогнать ВСЕ проверки, ничего не изменяя
#   make fix      починить то, что чинится само (ПЕРЕЗАПИСЫВАЕТ файлы)

UV  ?= uv
RUN := $(UV) run

# Что проверяем. Точка = весь репозиторий; .venv отсекается настройками
# ruff и mypy в pyproject.toml.
SRC ?= .

# Сводная цель `check` печатает findings в один-строчном виде: ruff по
# умолчанию рисует полный сниппет кода вокруг каждой находки, и на четырёх
# проверках подряд это 170+ строк вывода вместо сводки. Подробный вид
# остаётся у отдельных целей lint и format-check.
FMT := --output-format=concise

# Без этого целью по умолчанию стала бы первая в файле (help и так первая,
# но полагаться на порядок строк — хрупко).
.DEFAULT_GOAL := help

# ---------------------------------------------------------------------------
# Справка
# ---------------------------------------------------------------------------

help: ## Показать этот список
	@echo "nerode — доступные цели:"
	@echo
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'
	@echo

# ---------------------------------------------------------------------------
# Проверки: только читают, файлы не трогают
# ---------------------------------------------------------------------------

lint: ## Линтер: найти проблемы (ruff check)
	$(RUN) ruff check $(SRC)

format-check: ## Форматтер: показать, что он БЫ изменил, но не менять
	$(RUN) ruff format --check --diff $(SRC)

typecheck: ## Тайп-чекер (mypy)
	$(RUN) mypy $(SRC)

test: ## Тесты (pytest)
	$(RUN) pytest -q

lock-check: ## Проверить, что uv.lock соответствует pyproject.toml
	$(UV) lock --check

# Аккуратно: make по умолчанию останавливается на первой упавшей команде,
# но для «расскажи мне всё, что не так» это плохо. Поэтому здесь один
# shell-скрипт, который прогоняет всё и копит код возврата в $$fail.
# ($$ — это экранированный $: make съедает одиночный $ до того, как строку
#  увидит shell.)
check: ## ВСЁ СРАЗУ: lint + format-check + typecheck + test
	@fail=0; \
	printf '\n\033[1m─── lint ───\033[0m\n';        $(RUN) ruff check $(FMT) $(SRC)          || fail=1; \
	printf '\n\033[1m─── format ───\033[0m\n';      $(RUN) ruff format --check $(FMT) $(SRC) || fail=1; \
	printf '\n\033[1m─── typecheck ───\033[0m\n';   $(RUN) mypy $(SRC)                || fail=1; \
	printf '\n\033[1m─── tests ───\033[0m\n';       $(RUN) pytest -q                  || fail=1; \
	echo; \
	if [ $$fail -eq 0 ]; then printf '\033[32m✓ всё чисто\033[0m\n'; \
	else printf '\033[31m✗ есть замечания — см. выше\033[0m\n'; fi; \
	exit $$fail

# ---------------------------------------------------------------------------
# Исправления: ПЕРЕЗАПИСЫВАЮТ файлы
# ---------------------------------------------------------------------------

lint-fix: ## Починить то, что ruff умеет чинить сам
	$(RUN) ruff check --fix $(SRC)

format: ## Переформатировать код (схлопнет ручное выравнивание!)
	$(RUN) ruff format $(SRC)

fix: lint-fix format ## lint-fix + format одной командой

# ---------------------------------------------------------------------------
# Окружение
# ---------------------------------------------------------------------------

install: ## Поставить/обновить зависимости, включая dev-группу
	$(UV) sync

clean: ## Удалить кэши инструментов и __pycache__
	rm -rf .ruff_cache .mypy_cache .pytest_cache
	find . -path ./.venv -prune -o -name '__pycache__' -type d -print0 \
		| xargs -0 rm -rf

# .PHONY говорит make, что это не имена файлов. Без него цель `test` сломалась
# бы в тот день, когда в репозитории появится каталог с таким именем: make
# увидит «файл test уже есть, он новее зависимостей» и ничего не запустит.
.PHONY: help lint format-check typecheck test lock-check check \
        lint-fix format fix install clean

